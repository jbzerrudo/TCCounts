    given-names: Jef
    orcid: "https://orcid.org/0000-0001-7892-0999"
    affiliation: "Philippine Atmospheric, Geophysical and Astronomical Services Administration (PAGASA)"
repository-code: "https://github.com/jbzerrudo/TCCounts"
license: MIT
keywords:
  - tropical cyclone frequency
  - specification uncertainty
  - best-track homogeneity
  - Philippine Area of Responsibility
  - trend detection
  - IBTrACS
